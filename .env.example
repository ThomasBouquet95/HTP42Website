# Content editor at /admin. See docs/content-editor.md.

# Required: the password for the editor. Make it long.
ADMIN_PASSWORD=

# Required for saving. Added automatically by Vercel when you create a Blob
# store: Storage, then Create Database, then Blob, connected to this project.
# Without it the site renders the text in the build and the editor says it
# cannot save.
BLOB_READ_WRITE_TOKEN=

# Optional. Signs the session cookie. Derived from ADMIN_PASSWORD when unset,
# which means changing the password signs out any open session.
ADMIN_SESSION_SECRET=

# Local development only, ignored in production: save edits to this file
# instead of Blob.
# CONTENT_STORE_FILE=/tmp/htp42-content-overrides.json
